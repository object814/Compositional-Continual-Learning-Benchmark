# Weights & Biases settings. Copy this file to .env (it is never committed):
#   cp .env.example .env
# docker/run.sh passes these variables into the container. See the
# "Weights & Biases" section of README.md for details.

# Required for online logging: your API key from https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: the W&B account or team the runs are logged under.
# Leave commented out to use your personal account.
# WANDB_ENTITY=your-team-name

# Optional: where metrics go. One of:
#   online   - upload to wandb.ai (default when unset)
#   offline  - save only in each run's log directory; upload later with `wandb sync`
#   disabled - no W&B logging
# WANDB_MODE=online
